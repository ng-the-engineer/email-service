NODE_ENV="development"
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_AUTH_METHOD="password"
SMTP_USER="YOUR_SMTP_USER_NAME"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
# Required only when SMTP_AUTH_METHOD is "oauth2".
MICROSOFT_TENANT_ID="YOUR_MICROSOFT_TENANT_ID"
SMTP_CLIENT_ID="YOUR_ENTRA_APP_CLIENT_ID"
SMTP_CLIENT_SECRET="YOUR_ENTRA_APP_CLIENT_SECRET"
SMTP_REFRESH_TOKEN="YOUR_MICROSOFT_OAUTH_REFRESH_TOKEN"
RECIPIENT="YOUR_RECIPIENT_EMAIL_ADDRESS"